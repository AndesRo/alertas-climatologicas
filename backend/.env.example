# Todas son opcionales: los valores por defecto sirven para desarrollo local.

# Dónde guarda SQLite su archivo
DB_PATH=data/centinela.db

# Cada cuántos minutos consulta Open-Meteo y USGS
INGEST_INTERVAL_MIN=15

# false = no consulta las APIs (útil con datos de demo: python -m scripts.seed_demo)
SCHEDULER_ENABLED=true

# Habilita POST /api/refresh (para el cron de GitHub Actions). Usa un valor largo y aleatorio.
REFRESH_TOKEN=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,https://xn--alertas-climatolgicas-0cc.vercel.app
